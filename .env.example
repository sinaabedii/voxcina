POSTEX_API_KEY=
POSTEX_URL=https://api.postex.ir
SMSIR_ACCESS_KEY=
SMSIR_URL=https://api.sms.ir
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_ID=
SMSIR_CART_RECOVERY_TEMPLATE_ID=
INTERNAL_SECRET=

# OpenRouter AI Configuration
OPENROUTER_API_KEY=
APP_URL=https://voxcina.com

# OpenRouter AI Configuration (Customer Search & Recommendations)
OPENROUTER_MODEL=qwen/qwen3.7-plus
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Local Ollama Configuration
OLLAMA_ENDPOINT=http://host.docker.internal:8181
OLLAMA_API_KEY=

# FAISS Vector Search Service (optional but recommended for semantic search)
# Example when using docker-compose: http://faiss:8000
FAISS_BASE_URL=http://faiss:8000

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DB_NAME=ecommerce

# JWT signing secret. Use a random value of at least 32 characters.
JWT_SECRET=

# Payment Gateway Configuration
# Zibal - use "zibal" for test mode, your actual merchant ID for production
ZIBAL_MERCHANT=zibal

# DigiPay Payment Gateway
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_BASE_URL=https://api.mydigipay.com

# SnappPay online merchant gateway. Keep credentials server-side and obtain
# the authoritative staging URL/venture/callback whitelist from Snapppay.
SNAPPAY_BASE_URL=
SNAPPAY_RESOLVED_IP=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=
SNAPPAY_VENTURE=
SNAPPAY_CALLBACK_URL=
SNAPPAY_DEFAULT_CATEGORY=پوشاک
SNAPPAY_COMMISSION_TYPE=100

# ZarinPal - use "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" format
ZARINPAL_MERCHANT=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Override proxy for local dev (direct internet access)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mongo,docker.arvancloud.ir,gateway.zibal.ir,api.mydigipay.com,fms-gateway-staging.apps.public.okd4.teh-1.snappcloud.io,::1

# Development settings
TRYON_DEV_MODE=false
